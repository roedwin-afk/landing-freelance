---
// src/components/StackOferta.astro
import CtaButton from './CtaButton.astro';
---
<section class="offer-section section-padding">
    <div class="container">
        <div class="offer-box">
            <div class="offer-header">
                <span class="eyebrow">Lo Que Recibes Hoy</span>
                <h2>Fiverr Freelance Lite</h2>
            </div>

            <ul class="offer-list">
                <li><span class="check">✓</span> Acceso a los 8 módulos: desde primeros pasos hasta cómo ser irresistible para clientes</li>
                <li><span class="check">✓</span> 25 clases con 4 horas de contenido original</li>
                <li><span class="check">✓</span> Módulo bonus: errores comunes que te cuestan clientes</li>
                <li><span class="check">✓</span> Bonus próximo: Promociona tus servicios con Google Ads</li>
                <li><span class="check">✓</span> Estudia a tu manera, desde cualquier dispositivo</li>
                <li><span class="check">✓</span> Garantía de 7 días, sin letra pequeña</li>
            </ul>

            <div class="price-block">
                <span class="price">$75.00</span>
                <span class="price-note">Pago único &middot; acceso vía Hotmart</span>
            </div>

            <CtaButton text="Sí, Quiero Acceder a Fiverr Lite" utmSrc="stack_oferta_btn" />
            <p class="sub-cta">Pago 100% seguro y garantizado vía Hotmart</p>
        </div>
    </div>
</section>

<style>
    .offer-section { background-color: var(--color-surface); }
    .offer-box {
        max-width: 560px;
        margin: 0 auto;
        background: var(--color-primary);
        color: #ffffff;
        border-radius: var(--radius-lg);
        padding: var(--space-lg) var(--space-md);
        text-align: center;
        box-shadow: var(--shadow-lg);
    }
    .eyebrow { color: var(--color-secondary-light); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; font-size: 0.875rem; display: block; margin-bottom: 0.5rem; }
    .offer-header h2 { color: #ffffff; margin-bottom: var(--space-md); }
    .offer-list { list-style: none; text-align: left; margin: 0 auto var(--space-md) auto; max-width: 420px; display: flex; flex-direction: column; gap: 0.75rem; }
    .offer-list li { display: flex; align-items: flex-start; gap: 0.6rem; color: #cbd5e1; font-size: 0.95rem; line-height: 1.4; }
    .check { color: var(--color-secondary); font-weight: 700; flex-shrink: 0; }
    .price-block { margin: var(--space-md) 0 var(--space-sm) 0; }
    .price { font-family: var(--font-heading); font-size: 2.75rem; font-weight: 800; color: #ffffff; display: block; }
    .price-note { font-size: 0.8rem; color: #94a3b8; }
    .sub-cta { font-size: 0.75rem; margin-top: 0.5rem; color: #64748b; }
</style>