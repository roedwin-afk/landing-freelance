---
// src/components/LeadMagnet.astro
---

<section class="lead-section section-padding">
    <div class="container">
        <div class="lead-box">
            <span class="eyebrow">Gratis</span>
            <h2>3 errores que te cuestan clientes en Fiverr</h2>
            <p class="lead-subtitle">
                La guía corta que te muestra qué está espantando a tus clientes
                potenciales antes de que lean tu propuesta — y cómo corregirlo
                hoy mismo.
            </p>

            <form id="lead-form" class="lead-form">
                <input
                    type="text"
                    name="hp"
                    id="hp"
                    autocomplete="off"
                    tabindex="-1"
                    aria-hidden="true"
                    style="position:absolute; left:-9999px; opacity:0;"
                />
                <input
                    type="email"
                    id="lead-email"
                    name="email"
                    placeholder="Tu correo electrónico"
                    required
                    class="lead-input"
                />
                <button type="submit" id="lead-submit">
                    Quiero la guía gratis
                </button>
            </form>

            <p id="lead-message" class="lead-message" role="status"></p>

            <p class="lead-disclaimer">Sin spam. Un correo, y listo.</p>
        </div>
    </div>
</section>

<style>
    .lead-section {
        background-color: var(--color-surface);
    }
    .lead-box {
        max-width: 560px;
        margin: 0 auto;
        background: var(--color-primary);
        color: #ffffff;
        border-radius: var(--radius-lg);
        padding: var(--space-lg) var(--space-md);
        text-align: center;
        box-shadow: var(--shadow-lg);
    }
    .eyebrow {
        color: var(--color-secondary-light);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.875rem;
        display: block;
        margin-bottom: 0.5rem;
    }
    .lead-box h2 {
        color: #ffffff;
        margin-bottom: 0.75rem;
    }
    .lead-subtitle {
        color: #cbd5e1;
        margin-bottom: var(--space-md);
        font-size: 0.95rem;
    }

    .lead-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        max-width: 420px;
        margin: 0 auto;
    }
    .lead-input {
        padding: 0.9rem 1rem;
        border-radius: 50px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.06);
        color: #ffffff;
        font-size: 1rem;
    }
    .lead-input::placeholder {
        color: #94a3b8;
    }
    .lead-input:focus {
        outline: 2px solid var(--color-accent);
        border-color: transparent;
    }

    #lead-submit {
        display: inline-block;
        background-color: var(--color-accent);
        color: #ffffff;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1rem;
        padding: 0.9rem 1.5rem;
        border-radius: 50px;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.3s ease;
    }
    #lead-submit:hover:not(:disabled) {
        background-color: var(--color-accent-hover);
        transform: translateY(-2px);
    }
    #lead-submit:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .lead-message {
        min-height: 1.2em;
        margin-top: 0.75rem;
        font-size: 0.9rem;
    }
    .lead-message.success {
        color: #4ade80;
    }
    .lead-message.error {
        color: #f87171;
    }

    .lead-disclaimer {
        font-size: 0.75rem;
        margin-top: 0.5rem;
        color: #64748b;
    }

    @media (min-width: 640px) {
        .lead-form {
            flex-direction: row;
        }
        .lead-input {
            flex: 1;
        }
    }
</style>

<script>
    declare var fbq: any;

    const form = document.getElementById("lead-form") as HTMLFormElement | null;
    const messageEl = document.getElementById("lead-message");
    const submitBtn = document.getElementById(
        "lead-submit",
    ) as HTMLButtonElement | null;

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!messageEl || !submitBtn) return;

        const emailInput = document.getElementById(
            "lead-email",
        ) as HTMLInputElement;
        const hpInput = document.getElementById("hp") as HTMLInputElement;

        submitBtn.disabled = true;
        submitBtn.textContent = "Enviando...";
        messageEl.textContent = "";
        messageEl.className = "lead-message";

        try {
            const res = await fetch("/api/lead", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    email: emailInput.value,
                    hp: hpInput.value,
                }),
            });

            const data = await res.json();

            if (res.ok) {
                messageEl.textContent =
                    "Listo, revisa tu correo en unos minutos.";
                messageEl.className = "lead-message success";
                form.reset();

                if (typeof fbq !== "undefined") {
                    fbq("track", "Lead", {
                        content_name: "lead_magnet_errores_fiverr",
                    });
                }
            } else {
                messageEl.textContent =
                    data.error || "Algo salió mal, intenta de nuevo.";
                messageEl.className = "lead-message error";
            }
        } catch (err) {
            messageEl.textContent = "Error de conexión, intenta de nuevo.";
            messageEl.className = "lead-message error";
        } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = "Quiero la guía gratis";
        }
    });
</script>
